# Spring Configuration
SPRING_PROFILE=dev
SERVER_PORT=8080

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/atlas_reliable?replicaSet=atlas-rs&directConnection=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Python/Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
BACKEND_API_URL=http://localhost:8080
DEMO_MODE=true

# Local simulator: SUCCESS, REJECT, TIMEOUT_AFTER_SUCCESS, TIMEOUT_BEFORE_SUBMIT
ATLAS_EXECUTION_SCENARIO=SUCCESS
ATLAS_SEED_ENABLED=true
ATLAS_RECOVERY_ENABLED=true

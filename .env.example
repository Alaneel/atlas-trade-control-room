# Spring Configuration
SPRING_PROFILE=dev
SERVER_PORT=8080
# Set false to keep fixture loading disabled against an existing database.
APP_SEED_DATA_ENABLED=true
# Optional writable path; logs otherwise go to stdout.
# LOGGING_FILE_NAME=/app/logs/atlas.log

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/atlas_trade_control

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Python/Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
BACKEND_API_URL=http://localhost:8080
DEMO_MODE=true
